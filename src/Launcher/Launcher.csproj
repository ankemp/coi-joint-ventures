<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <Version>$(JointVenturesVersion)</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JointVentures</AssemblyName>
    <RootNamespace>JointVentures.Launcher</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded BepInEx bundle — created by build-release.ps1 -->
    <EmbeddedResource Include="plugin-bundle.zip" LogicalName="plugin-bundle.zip" Condition="Exists('plugin-bundle.zip')" />
  </ItemGroup>

  <!-- Embed a build timestamp into AssemblyInformationalVersion for local builds (e.g. "0.3.6-LOCAL+20260409183045") -->
  <Target Name="SetSourceRevisionId" BeforeTargets="GenerateAssemblyInfo">
    <PropertyGroup>
      <!-- Only append a build timestamp for local builds, ensuring every rebuild gets a unique version. -->
      <SourceRevisionId Condition="'$(AppendSourceRevisionId)' == 'true'">$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
